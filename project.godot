; Engine configuration file.
; Happy Farm - Godot 4 browser game

config_version=5

[application]
config/name="Happy Farm"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Standalone farming game with crops, fruit trees and pigs"

[display]
window/size/viewport_width=1120
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.72, 0.84, 0.64, 1)
